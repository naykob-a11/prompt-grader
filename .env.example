# =============================================================================
# Prompt Grader — Environment variables
# -----------------------------------------------------------------------------
# วิธีใช้
#   cp .env.example .env.local      # ค่าเฉพาะเครื่องของคุณ (ไม่ commit)
#   pnpm dev
#
# ไฟล์ที่ Vite อ่าน (vite.config.ts ตั้ง envDir = รากโปรเจค)
#   .env                ค่าร่วมทุกโหมด (commit ได้ ถ้าไม่มีอะไรเฉพาะเครื่อง)
#   .env.local          ค่าเฉพาะเครื่อง (อยู่ใน .gitignore)
#   .env.development    ใช้กับ pnpm dev
#   .env.production     ใช้กับ pnpm build
#   .env.test           ใช้กับ Vitest / Playwright
#
# ข้อควรรู้
#   - ตัวแปรที่ขึ้นต้นด้วย VITE_ ถูกฝังลงในไฟล์ JavaScript ที่ผู้ใช้ดาวน์โหลด
#     จึงเป็นข้อมูลสาธารณะเสมอ ห้ามใส่รหัสผ่าน token หรือ API key
#     (โปรเจคนี้ไม่มีความลับ และไม่เรียกบริการภายนอก)
#   - ทุกตัวมีค่าเริ่มต้นใน apps/web/src/config/env.ts ไม่ตั้งค่าเลยก็รันได้
#   - ค่าผิดรูปแบบ → build ล้มเหลวพร้อมข้อความบอกชื่อตัวแปร (ตรวจด้วย zod)
#   - boolean ใช้ true/false, ตัวเลขเป็นจำนวนเต็ม
# =============================================================================


# ---------------------------------------------------------------------------
# 1) การ build และโฮสต์
# ---------------------------------------------------------------------------

# path ที่เว็บถูกเสิร์ฟ ต้องขึ้นต้นและลงท้ายด้วย /
#   Cloudflare Pages / Netlify / โดเมนของตัวเอง → /
#   GitHub Pages แบบ project site               → /prompt-grader/
VITE_BASE_PATH=/

# ชื่อแอปที่แสดงในแท็บเบราว์เซอร์และตอนติดตั้งเป็นแอป (PWA)
VITE_APP_NAME=เกรดสีจากพร้อมต์
VITE_APP_SHORT_NAME=Prompt Grader

# ช่องทางเผยแพร่ แสดงเป็นป้ายเล็กมุมจอเมื่อไม่ใช่ production
#   development | preview | production
VITE_RELEASE_CHANNEL=development


# ---------------------------------------------------------------------------
# 2) ค่าเริ่มต้นของแอป (ผู้ใช้เปลี่ยนเองได้ในหน้าตั้งค่า ค่านี้ใช้ครั้งแรกเท่านั้น)
# ---------------------------------------------------------------------------

# ภาษาของหน้าจอ  th | en
VITE_DEFAULT_LOCALE=th

# ธีม  system | light | dark
VITE_DEFAULT_THEME=system

# พรีเซ็ตที่เลือกไว้ตอนเปิดครั้งแรก (id จาก seed/builtin-presets.json)
VITE_DEFAULT_PRESET_ID=builtin:b1

# โหมดเทียบภาพ  split | after | before
VITE_DEFAULT_COMPARE_MODE=split

# แสดงภาพตัวอย่างเมื่อยังไม่ได้เปิดภาพ
VITE_SHOW_SAMPLE_IMAGE=true


# ---------------------------------------------------------------------------
# 3) การส่งออกภาพ (ค่าเริ่มต้นใน ExportDialog)
# ---------------------------------------------------------------------------

# รูปแบบไฟล์  jpeg | png | webp
VITE_EXPORT_FORMAT=jpeg

# คุณภาพ JPEG/WebP  60–100
VITE_EXPORT_QUALITY=95

# คัดลอกข้อมูล EXIF เดิมลงไฟล์ที่ส่งออก (เฉพาะ JPEG)
VITE_EXPORT_KEEP_EXIF=true

# ตัดพิกัด GPS ออกจาก EXIF (แนะนำ true โดยเฉพาะภาพบุคคล/ภาพเด็ก)
VITE_EXPORT_STRIP_GPS=true


# ---------------------------------------------------------------------------
# 4) ขีดจำกัดความปลอดภัย (ดู docs/11-security-privacy.md)
#    ลดได้ตามต้องการ — การเพิ่มเกินค่านี้ต้องทดสอบหน่วยความจำและความเร็วใหม่
# ---------------------------------------------------------------------------

# ไฟล์พร้อมต์ .sgp.txt
VITE_MAX_PROMPT_BYTES=65536
VITE_MAX_PROMPT_LINES=2000

# ไฟล์คลังพร้อมต์ .json
VITE_MAX_LIBRARY_BYTES=5242880
VITE_MAX_LIBRARY_ITEMS=1000

# ภาพที่เปิดได้ (ล้านพิกเซล) — ภาพใหญ่กว่านี้แจ้งเตือนก่อนเปิด
VITE_MAX_IMAGE_MEGAPIXELS=60


# ---------------------------------------------------------------------------
# 5) ประสิทธิภาพ
# ---------------------------------------------------------------------------

# ด้านยาวของภาพพรีวิว (px) — ต่ำลงเร็วขึ้นบนเครื่องสเปกต่ำ
VITE_PREVIEW_MAX_SIDE=2048

# ขนาดไทล์ตอนส่งออกด้วย GPU (px) — ถูกจำกัดด้วย MAX_TEXTURE_SIZE ของเครื่องอยู่แล้ว
VITE_EXPORT_TILE_SIZE=4096

# หน่วงการอ่านพร้อมต์หลังหยุดพิมพ์ (ms)
VITE_PARSE_DEBOUNCE_MS=150

# จำนวนขั้นย้อนกลับ (undo)
VITE_UNDO_LIMIT=50

# บังคับใช้เครื่องยนต์ CPU แทน WebGL2 (ใช้ทดสอบเครื่องที่ GPU มีปัญหา)
VITE_FORCE_CPU_ENGINE=false


# ---------------------------------------------------------------------------
# 6) เปิด/ปิดฟีเจอร์
# ---------------------------------------------------------------------------

# ปุ่ม "คัดลอกคำสั่งสำหรับแชต Claude"
VITE_FEATURE_CHAT_BRIDGE=true

# ใช้งานออฟไลน์และติดตั้งเป็นแอป (service worker) — ปิดระหว่างพัฒนาได้ถ้าแคชรบกวน
VITE_FEATURE_PWA=true

# แสดง histogram ใต้ภาพ
VITE_FEATURE_HISTOGRAM=true

# เตือนให้ส่งออกคลังพร้อมต์เพื่อสำรองทุก n วัน (0 = ไม่เตือน)
VITE_BACKUP_REMINDER_DAYS=30


# ---------------------------------------------------------------------------
# 7) สำหรับนักพัฒนา (ตั้งเป็น false ใน .env.production เสมอ)
# ---------------------------------------------------------------------------

# แผงดีบัก: เวลาเรนเดอร์ต่อเฟรม, เครื่องยนต์ที่ใช้, ปุ่มเปิด/ปิดแต่ละขั้นของ pipeline
VITE_DEBUG_PANEL=false

# พิมพ์ผลการอ่านพร้อมต์ (params + คำเตือน) ลง console
VITE_DEBUG_SGP=false


# =============================================================================
# ตัวแปรฝั่งเครื่องมือ (ไม่ขึ้นต้น VITE_ จึงไม่ถูกฝังในเว็บ)
# =============================================================================

# พอร์ตของ pnpm dev / pnpm preview
DEV_PORT=5173
PREVIEW_PORT=4173

# Playwright: URL ที่ e2e ทดสอบ (เว้นว่าง = เปิด pnpm preview ให้อัตโนมัติ)
E2E_BASE_URL=

# Playwright: ใช้ GPU จำลองแบบ software เพื่อให้ผล parity คงที่บน CI
E2E_SWIFTSHADER=true

# Golden test: ค่า PSNR ขั้นต่ำ (dB) ที่ถือว่าภาพตรงกับภาพอ้างอิง
GOLDEN_MIN_PSNR=45

# GPU parity: ความต่างสูงสุดต่อช่องสี (หน่วย 0–255)
PARITY_MAX_DIFF=2
